        "properties": {
          "reservation_id": {
            "title": "Reservation Id",
            "type": "string"
          }
        },
        "required": [
          "reservation_id"
        ],
        "title": "get_reservationArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "get_reservationOutput",
        "type": "object"
      }
    },
