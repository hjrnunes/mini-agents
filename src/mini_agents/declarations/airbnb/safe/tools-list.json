      "name": "update_listing",
      "description": "Update listing configuration. Invalid or unsafe configs are rejected in safe mode.",
      "inputSchema": {
        "properties": {
          "listing_id": {
            "title": "Listing Id",
            "type": "string"
          },
          "occupancy": {
            "title": "Occupancy",
            "type": "integer"
          },
          "config_flags": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Config Flags"
