            "default": null,
            "title": "Patient Id"
          }
        },
        "title": "get_patient_profileArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "title": "Result",
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "title": "get_patient_profileOutput",
        "type": "object"
      }
    },
