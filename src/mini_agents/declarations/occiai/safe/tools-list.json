    {
      "name": "get_patient_profile",
      "description": "Return a patient's profile. Omit patient_id for the signed-in patient.",
      "inputSchema": {
        "properties": {
          "patient_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
