{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mini-agents-tool-manifest-v1",
  "description": "Static tool manifest of the three mini-agents targets. Generated by scripts/gen_manifest.py; do not edit tool-manifest.json by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "targets"],
  "properties": {
    "schema_version": { "const": "mini-agents-tool-manifest-v1" },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["klarna", "airbnb", "occiai"],
      "properties": {
        "klarna": { "$ref": "#/$defs/target" },
        "airbnb": { "$ref": "#/$defs/target" },
        "occiai": { "$ref": "#/$defs/target" }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
    },
    "slotId": {
      "type": "string",
      "pattern": "^[a-z]+\\.[a-z_]+\\.[a-z_]+$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools", "seed_slots"],
      "properties": {
        "tools": {
          "description": "Every tool the server registers, sorted by name. access is write when the tool creates or changes a ledger record. returns_planted_slots lists the slots whose planted text the tool can return in at least one mode, including the state-summary tool.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "access", "returns_planted_slots"],
            "properties": {
              "name": { "$ref": "#/$defs/identifier" },
              "access": { "enum": ["read", "write"] },
              "returns_planted_slots": {
                "type": "array",
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/slotId" }
              }
            }
          }
        },
        "seed_slots": {
          "description": "Text fields that --seed-file can plant. records lists the record ids accepted without --unsafe; unsafe_records lists those accepted with it. The two executors return different records, and a seed on a record the carrier never returns would reach no agent.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "carrier_operation",
              "field",
              "controller",
              "content_kind",
              "records",
              "unsafe_records"
            ],
            "properties": {
              "id": { "$ref": "#/$defs/slotId" },
              "carrier_operation": { "$ref": "#/$defs/identifier" },
              "field": {
                "description": "Path of the planted text in the carrier's result; [] marks an array.",
                "type": "string",
                "minLength": 1
              },
              "controller": {
                "enum": ["third_party", "counterparty", "operator_insider"]
              },
              "content_kind": {
                "enum": [
                  "policy_document",
                  "listing_content",
                  "order_content",
                  "clinical_note",
                  "education_material",
                  "message",
                  "review",
                  "other"
                ]
              },
              "records": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/identifier" }
              },
              "unsafe_records": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/identifier" }
              }
            }
          }
        }
      }
    }
  }
}
