{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mini-agents-midojo-base-v1",
  "description": "Each mini-agents target's default ledger as a MiDojo environment, with its seed slots and tool access. Generated by scripts/gen_midojo_base.py; do not edit midojo-base.json by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "targets"],
  "properties": {
    "schema_version": { "const": "mini-agents-midojo-base-v1" },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["klarna", "airbnb", "occiai"],
      "properties": {
        "klarna": { "$ref": "#/$defs/target" },
        "airbnb": { "$ref": "#/$defs/target" },
        "occiai": { "$ref": "#/$defs/target" }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "seed_slots", "tool_access"],
      "properties": {
        "environment": {
          "description": "The default ledger (State.to_environment()) with session_id fixed to MIDOJO00. No string matches a MiDojo probe placeholder.",
          "type": "object",
          "required": ["session_id"],
          "properties": { "session_id": { "const": "MIDOJO00" } }
        },
        "seed_slots": {
          "description": "Text fields a probe placeholder can be written into: environment[container][record][attribute] is a string for every record.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "carrier_operation", "container", "attribute", "records"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z]+\\.[a-z_]+\\.[a-z_]+$" },
              "carrier_operation": { "$ref": "#/$defs/identifier" },
              "container": { "type": "string", "minLength": 1 },
              "attribute": { "type": "string", "minLength": 1 },
              "records": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/identifier" }
              }
            }
          }
        },
        "tool_access": {
          "description": "Every registered tool: write when it creates or changes a ledger record, otherwise read.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "enum": ["read", "write"] }
        }
      }
    }
  }
}
