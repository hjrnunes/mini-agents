{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mini-agents-midojo-base-v1",
  "description": "Each mini-agents target's default ledger as a MiDojo environment, with its seed slots and tool access, plus the sandbox runtime every target shares. Generated by scripts/gen_midojo_base.py; do not edit midojo-base.json by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtime", "targets"],
  "properties": {
    "schema_version": { "const": "mini-agents-midojo-base-v1" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["klarna", "airbnb", "occiai"],
      "properties": {
        "klarna": { "$ref": "#/$defs/target" },
        "airbnb": { "$ref": "#/$defs/target" },
        "occiai": { "$ref": "#/$defs/target" }
      }
    }
  },
  "$defs": {
    "runtime": {
      "description": "How MiDojo's openshell runtime runs every target: one image, one policy, one agent command. A value in angle brackets is a slot the consumer fills; a slot is a JSON string exactly equal to its name.",
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "agent_command", "policy"],
      "properties": {
        "image": {
          "description": "Slot <image_id>: the bare image ID (sha256:...) of the image built from Dockerfile.sandbox. Never name@sha256:, which makes OpenShell try a pull.",
          "const": "<image_id>"
        },
        "agent_command": {
          "description": "What MiDojo execs in /sandbox/workdir as uid 1500, with HOME=/sandbox and without the image's ENV; MiDojo appends the user message. Slot <domain>: the target's key in targets.",
          "type": "array",
          "prefixItems": [
            { "const": "/opt/app-root/.venv/bin/mini-agents-sandbox-agent" },
            { "const": "--domain" },
            { "const": "<domain>" }
          ],
          "minItems": 3,
          "items": false
        },
        "policy": { "$ref": "#/$defs/policy" }
      }
    },
    "policy": {
      "description": "OpenShell SandboxSpec.policy in camelCase proto-JSON, copied from src/mini_agents/sandbox-policy.json. Network is default-deny: only the two interpreter copies get egress, each to one host port. Slots <control_plane_port> and <relay_port> take the port as an integer.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "filesystem", "landlock", "process", "networkPolicies"],
      "properties": {
        "version": { "const": 1 },
        "filesystem": {
          "type": "object",
          "additionalProperties": false,
          "required": ["includeWorkdir", "readOnly", "readWrite"],
          "properties": {
            "includeWorkdir": { "const": true },
            "readOnly": { "$ref": "#/$defs/absolute_paths" },
            "readWrite": { "$ref": "#/$defs/absolute_paths" }
          }
        },
        "landlock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["compatibility"],
          "properties": { "compatibility": { "const": "best_effort" } }
        },
        "process": {
          "description": "The image user, uid and gid 1500. The image has no user named sandbox.",
          "type": "object",
          "additionalProperties": false,
          "required": ["runAsUser", "runAsGroup"],
          "properties": {
            "runAsUser": { "const": "1500" },
            "runAsGroup": { "const": "1500" }
          }
        },
        "networkPolicies": {
          "type": "object",
          "additionalProperties": false,
          "required": ["control_plane", "model_relay"],
          "properties": {
            "control_plane": {
              "description": "The domain's MCP server, run by python-mcp, reaches MiDojo's control plane.",
              "allOf": [{ "$ref": "#/$defs/egress_rule" }],
              "properties": {
                "endpoints": { "items": { "properties": { "port": { "const": "<control_plane_port>" } } } },
                "binaries": { "items": { "properties": { "path": { "const": "/opt/app-root/.venv/bin/python-mcp" } } } }
              }
            },
            "model_relay": {
              "description": "OGX, run by python-ogx, reaches the model relay.",
              "allOf": [{ "$ref": "#/$defs/egress_rule" }],
              "properties": {
                "endpoints": { "items": { "properties": { "port": { "const": "<relay_port>" } } } },
                "binaries": { "items": { "properties": { "path": { "const": "/opt/app-root/.venv/bin/python-ogx" } } } }
              }
            }
          }
        }
      }
    },
    "egress_rule": {
      "description": "One binary to one endpoint on the host.",
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoints", "binaries"],
      "properties": {
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["host", "port"],
            "properties": {
              "host": { "const": "host.openshell.internal" },
              "port": { "type": "string", "pattern": "^<[a-z_]+>$" }
            }
          }
        },
        "binaries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": { "path": { "type": "string", "pattern": "^/" } }
          }
        }
      }
    },
    "absolute_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^/" }
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "seed_slots", "tool_access"],
      "properties": {
        "environment": {
          "description": "The default ledger (State.to_environment()) with session_id fixed to MIDOJO00. No string matches a MiDojo probe placeholder.",
          "type": "object",
          "required": ["session_id"],
          "properties": { "session_id": { "const": "MIDOJO00" } }
        },
        "seed_slots": {
          "description": "Text fields a probe placeholder can be written into: environment[container][record][attribute] is a string for every record.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "carrier_operation", "container", "attribute", "records"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z]+\\.[a-z_]+\\.[a-z_]+$" },
              "carrier_operation": { "$ref": "#/$defs/identifier" },
              "container": { "type": "string", "minLength": 1 },
              "attribute": { "type": "string", "minLength": 1 },
              "records": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/identifier" }
              }
            }
          }
        },
        "tool_access": {
          "description": "Every registered tool: write when it creates or changes a ledger record, otherwise read.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "enum": ["read", "write"] }
        }
      }
    }
  }
}
